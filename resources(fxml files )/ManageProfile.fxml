<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="application.ManageProfileController" fitToWidth="true">

    <VBox spacing="20" style="-fx-padding: 20;">

        <Label text="Manage Your Profile" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />

        <!-- Profile Overview -->
        <HBox spacing="20">
            <VBox spacing="10" prefWidth="300"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                <ImageView fx:id="profileImage" fitHeight="120" fitWidth="120" preserveRatio="true" />
                <Label fx:id="nameLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Your Name" />
                <Label fx:id="emailLabel" style="-fx-text-fill: #7f8c8d;" text="your.email@example.com" />
                <Label fx:id="phoneLabel" style="-fx-text-fill: #7f8c8d;" text="+1234567890" />
            </VBox>

            <!-- Update Profile Form -->
            <VBox spacing="15"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">

                <Label text="Update Profile" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="30" />
                        <ColumnConstraints percentWidth="70" />
                    </columnConstraints>

                    <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                    <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                    <Label text="Phone:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                    <Label text="New Password:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                    <PasswordField fx:id="passwordField" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                </GridPane>

                <Button text="Save Changes" fx:id="saveProfileButton"
                        onAction="#handleSaveProfile"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-background-radius: 5;" />
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
