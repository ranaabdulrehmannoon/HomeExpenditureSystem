<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.chart.*?>

<ScrollPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="application.ManageBudgetController" fitToWidth="true">
    <VBox spacing="20" style="-fx-padding: 20;">
        <Label text="Manage Your Budget" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />

        <HBox spacing="20">
            <!-- Current Budget Section -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" spacing="10" prefWidth="300">
                <Label text="Current Budget" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <Label fx:id="currentBudgetLabel" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />
                <Label text="Last updated: " fx:id="lastUpdatedLabel" style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;" />
            </VBox>

            <!-- Budget Allocation Pie Chart -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" spacing="10">
                <Label text="Budget Allocation" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                <PieChart fx:id="budgetPieChart" prefWidth="400" prefHeight="300" />
            </VBox>
        </HBox>

        <!-- Update Budget Section -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" spacing="15">
            <Label text="Update Monthly Budget" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="30" />
                    <ColumnConstraints percentWidth="70" />
                </columnConstraints>
                
                <Label text="New Budget Amount:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="budgetAmountField" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                
                <Label text="Budget Month:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <ComboBox fx:id="monthComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                
                <Label text="Budget Year:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <ComboBox fx:id="yearComboBox" GridPane.rowIndex="2" GridPane.columnIndex="1" />
            </GridPane>
            
            <Button text="Update Budget" fx:id="updateBudgetButton" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" 
                    onAction="#handleUpdateBudget" />
        </VBox>

        <!-- Budget History Table -->
        <VBox style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" spacing="10">
            <Label text="Budget History" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
            <TableView fx:id="budgetHistoryTable" prefHeight="200">
                <columns>
                    <TableColumn text="Month" fx:id="monthColumn" prefWidth="100" />
                    <TableColumn text="Year" fx:id="yearColumn" prefWidth="80" />
                    <TableColumn text="Budget Amount" fx:id="amountColumn" prefWidth="120" />
                    <TableColumn text="Date Updated" fx:id="dateColumn" prefWidth="150" />
                </columns>
            </TableView>
        </VBox>
    </VBox>
</ScrollPane>