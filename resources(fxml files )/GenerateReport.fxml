<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="application.GenerateReportController"
      spacing="20" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15;">
    
    <Label text="Generate Financial Report" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498db;" />

    <!-- Report Controls -->
    <HBox spacing="20">
        <VBox spacing="10" prefWidth="300">
            <Label text="Report Type" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="reportTypeComboBox" promptText="Select report type" />
        </VBox>
        
        <VBox spacing="10">
            <Label text="Date Range" style="-fx-font-weight: bold;" />
            <HBox spacing="10">
                <DatePicker fx:id="startDatePicker" promptText="Start Date" />
                <Label text="to" />
                <DatePicker fx:id="endDatePicker" promptText="End Date" />
            </HBox>
        </VBox>
        
        <Button fx:id="generateButton" text="Generate Report" onAction="#handleGenerateReport"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" />
    </HBox>

    <!-- Report Summary -->
    <Label fx:id="reportSummaryLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

    <!-- Charts -->
    <HBox spacing="20">
        <VBox spacing="10" prefWidth="400">
            <BarChart fx:id="barChart">
                <xAxis>
                    <CategoryAxis label="Categories" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Amount ($)" />
                </yAxis>
            </BarChart>
        </VBox>
        <VBox spacing="10" prefWidth="300">
            <PieChart fx:id="pieChart" />
        </VBox>
    </HBox>

    <!-- Detailed Data Table -->
    <TableView fx:id="reportTable" prefHeight="200">
        <columns>
            <TableColumn fx:id="categoryColumn" text="Category" prefWidth="200" />
            <TableColumn fx:id="amountColumn" text="Amount" prefWidth="100" />
        </columns>
    </TableView>
</VBox>